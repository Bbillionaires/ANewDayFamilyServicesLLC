# Public site URL — used for canonical links, sitemap.xml, and JSON-LD structured data.
# REPLACE with the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.anewdayfamilyservices.com

# Anthropic API key that powers the "Ask Us Anything" AI assistant widget.
# Without this set, the widget falls back to a static FAQ message instead of erroring.
ANTHROPIC_API_KEY=

# Square (donation / sponsorship checkout) — replace with real values before accepting live payments.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# Contact info — defaults to the real values hardcoded in src/lib/siteConfig.ts.
# Only set these if you need to override them per-deployment (e.g. a staging environment).
NEXT_PUBLIC_CONTACT_PHONE=(904) 270-9463
NEXT_PUBLIC_CONTACT_EMAIL=Info@anewdayfamilyservices.com

# Google Workspace / Gmail account that sends the Careers page application emails
# (applicant's details + resume). Without both GMAIL_USER and GMAIL_APP_PASSWORD set,
# the form tells applicants to email their resume directly instead of erroring.
# GMAIL_USER is the full mailbox address (e.g. Info@anewdayfamilyservices.com).
# GMAIL_APP_PASSWORD is a 16-character App Password — NOT the regular account password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be turned on for the account first).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where completed career applications are sent — defaults to NEXT_PUBLIC_CONTACT_EMAIL above.
# Usually the same address as GMAIL_USER.
CAREERS_NOTIFICATION_EMAIL=

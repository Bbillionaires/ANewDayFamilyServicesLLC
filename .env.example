# Public site URL — used for canonical links, sitemap.xml, and JSON-LD structured data.
# REPLACE with the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://www.anewdayfamilyservices.com

# Square (donation / sponsorship checkout) — replace with real values before accepting live payments.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# Contact info — defaults to the real values hardcoded in src/lib/siteConfig.ts.
# Only set these if you need to override them per-deployment (e.g. a staging environment).
NEXT_PUBLIC_CONTACT_PHONE=(904) 270-9463
NEXT_PUBLIC_CONTACT_EMAIL=Info@anewdayfamilyservices.com

# Resend API key that powers the Careers page application form (sends the applicant's
# details + resume by email). Without this set, the form tells applicants to email
# their resume directly instead of erroring. Get a key at https://resend.com.
RESEND_API_KEY=

# Where completed career applications are sent — defaults to NEXT_PUBLIC_CONTACT_EMAIL above.
CAREERS_NOTIFICATION_EMAIL=

# The "from" address Resend sends application emails from. Must be on a domain you've
# verified in Resend (Resend rejects unverified sending domains) — replace before launch.
CAREERS_FROM_EMAIL=careers@anewdayfamilyservices.com

# The Booking page's "Book an Appointment" button — set this to the business's Google
# Calendar Appointment Schedule booking page URL. The owner manages availability, blocked
# time off, and bookings entirely from their own Google Calendar; the site just links out
# to it. Without this set, the button is shown disabled with a "call or email us" message.
NEXT_PUBLIC_GOOGLE_CALENDAR_BOOKING_URL=

# The Booking page's "Make a Payment" button — set this to the business's existing payment
# page or payment link (e.g. a Square payment link). Completely independent of booking —
# a customer does not need to pay in order to book an appointment. Without this set, the
# button is shown disabled with a "call or email us" message.
NEXT_PUBLIC_PAYMENT_LINK_URL=
